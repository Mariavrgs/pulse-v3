# Copy to .env for local development. Never commit real credentials.
NODE_ENV=development
LOG_LEVEL=info

# Host port for the Postgres container. If 5432 is taken (e.g. by a native
# Postgres install), change it here AND in DATABASE_URL below. They must match.
# Note: variable expansion like ${POSTGRES_PORT} is not supported in this file.
POSTGRES_PORT=5432

# These match docker-compose.yml (local-only credentials)
DATABASE_URL=postgresql://pulse:pulse@localhost:5432/pulse
REDIS_URL=redis://localhost:6379

# Signs access tokens. This placeholder is for local use only; the app refuses it in
# production. Generate a real one with: openssl rand -base64 48
JWT_SECRET=dev-only-insecure-secret-do-not-use-in-production
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

API_HOST=0.0.0.0
API_PORT=3000

WORKER_CONCURRENCY=20
WORKER_PER_HOST_CONCURRENCY=5
SCHEDULER_INTERVAL_MS=1000
SCHEDULER_BATCH_SIZE=100
MAX_QUEUE_DEPTH=5000

# SSRF escape hatch for local/integration tests ONLY. The app refuses to start
# with this set to true when NODE_ENV=production.
ALLOW_PRIVATE_TARGETS=false
